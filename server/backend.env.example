NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

MONGODB_URI=mongodb://mongo:27017/family_library
SESSION_SECRET=replace_with_a_secure_secret

UPLOAD_DIR=uploads
MAX_PDF_UPLOAD_MB=25
MAX_IMAGE_UPLOAD_MB=5
MAX_VIDEO_UPLOAD_MB=100

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

INITIAL_ADMIN_EMAIL=admin@family.local
INITIAL_ADMIN_PASSWORD=change_this_secure_password

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=no-reply@example.com
